# ─────────────────────────────────────────────────────────────────────────
# Docker Compose secrets — TEMPLATE. Safe to commit (no real values).
#
# Setup:
#   1. cp .env.example .env
#   2. Fill in real values below (generate, don't reuse examples)
#   3. .env is gitignored — `docker compose up` reads it automatically
# ─────────────────────────────────────────────────────────────────────────

# ── Postgres (container "db") ───────────────────────────────────────────
DB_USER=dk_user
# Generate with: openssl rand -base64 24   (or) python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=changeme-generate-a-strong-password
DB_NAME=dk_crm

# ── Backend JWT signing key (container "backend") ──────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be a fresh value — never reuse a key that has ever appeared in git history.
SECRET_KEY=changeme-use-a-strong-secret-in-production
